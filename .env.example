# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...         # from @BotFather
TELEGRAM_CHAT_ID=...           # your personal chat ID — from @userinfobot

# ── Azure VM ───────────────────────────────────────────────────────────────────
# Set the DNS name label in Azure Portal → VM → Configuration → DNS name label.
# Example result: garmin-vm.westeurope.cloudapp.azure.com
FQDN=garmin-vm.westeurope.cloudapp.azure.com

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=garmin
POSTGRES_USER=garmin_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASS=CHANGE_ME_strong_password
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ── Tailscale / Power BI connection info (not used by Docker — informational) ──
# After `sudo tailscale up` on the VM, run: tailscale ip -4
# Use this IP in Power BI:  Host=<ip>  Port=5432  Database=garmin
# TAILSCALE_VM_IP=100.x.x.x
